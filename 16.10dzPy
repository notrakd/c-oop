class Sorting:
    def __init__(self, arr):
        self.arr = arr

    def stupid_sort_up(self):
        n = len(self.arr)

        for i in range(n):
            for j in range(n - 1):
                if self.arr[j] > self.arr[j + 1]:
                    self.arr[j], self.arr[j + 1] = self.arr[j + 1], self.arr[j]

    def stupid_sort_down(self):
        n = len(self.arr)

        for i in range(n):
            for j in range(n - 1):
                if self.arr[j] < self.arr[j + 1]:
                    self.arr[j], self.arr[j + 1] = self.arr[j + 1], self.arr[j]

    def Print(self):
        print(self.arr)


def main():
    a = Sorting([5, 2, 8, 1, 3])
    a.Print()
    a.stupid_sort_up()
    print("Up")
    a.Print()
    a.stupid_sort_down()
    print("DOWN")
    a.Print()


if __name__ == '__main__':
    main()
