#include <iostream>
#include <fstream>
using namespace std;

int main()
{
    fstream inout("Text.txt", ios::in);

    char read[100];
    int lines = 0;
    int words = 0;

    while(inout.getline(read, 100))
    {
        lines++;

        bool inWord = false;

        for(int i = 0; read[i] != '\0'; i++)
        {
            if(read[i] != ' ' && read[i] != '\t')
            {
                if(!inWord)
                {
                    words++;
                    inWord = true;
                }
            }
            else
            {
                inWord = false;
            }
        }
    }

    cout << "Stroki " << lines << endl;
    cout << "Slova " << words << endl;

    inout.close();

    return 0;
}
