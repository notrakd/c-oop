int main()
{
    Vehicle* vehicle = nullptr;

    int choice = 0;

    cout << "1. двушка" << endl;
    cout << "2. лёшка" << endl;
    cout << "3. жипка" << endl;
    cout << "4. автобуска" << endl;
    cout << "5. фурка" << endl;
    cout << "Make your choice: ";

    cin >> choice;

    switch (choice)
    {
        case 1:
            vehicle = new Twoweels("Merida", "blue", 2022, 2, 600, 35, true, 19, "rim");
            break;
        case 2:
            vehicle = new Car("Toyota", "yellow", 2019, 4, 18000, 190, 4, 5, "automatic");
            break;
        case 3:
            vehicle = new Jeep("Jimny", "purple", 2021, 4, 25000, 145, true, 210, "mud");
            break;
        case 4:
            vehicle = new Bus("MAN", "orange", 2018, 6, 250000, 90, 90, 3, true);
            break;
        case 5:
            vehicle = new Truck("Volvo", "red", 2017, 10, 120000, 110, 20, true, "furniture");
            break;
        default:
            cout << "Wrong choice" << endl;
            return 1;
    }

    cout << endl;
    vehicle->Print();

    cout << endl;
    vehicle->MaxSpeed();
    vehicle->FuelConsumption();
    vehicle->WheelsCount();
    vehicle->PassengersCount();

    return 0;
}
