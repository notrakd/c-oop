#include <iostream>
#include <string>
using namespace std;

class Vehicle
{
protected:
    string model;
    string color;
    int year;
    int wheels;
    double price;
    double max_speed;
public:
    Vehicle() {};
    Vehicle(string mod, string col, int ye, int whe, double pri, double sp)
    {
        model = mod;
        color = col;
        year = ye;
        wheels = whe;
        price = pri;
        max_speed = sp;
    }

    virtual void Print()
    {
        cout << "Model " << model << endl;
        cout << "Color " << color << endl;
        cout << "Year " << year << endl;
        cout << "Wheels " << wheels << endl;
        cout << "Price " << price << endl;
        cout << "Max_speed " << max_speed << endl;
    }

    void Init()
    {
        model = " ";
        color = " ";
        year = 0;
        wheels = 0;
        price = 0;
        max_speed = 0;
    }

    void Init(string mod, string col, int ye, int whe, double pri, double sp)
    {
        model = mod;
        color = col;
        year = ye;
        wheels = whe;
        price = pri;
        max_speed = sp;
    }

    virtual void MaxSpeed() const = 0;
    virtual void FuelConsumption() const = 0;
    virtual void WheelsCount() const = 0;
    virtual void PassengersCount() const = 0;
};

class Twoweels : public Vehicle
{
    bool hasBasket;
    double frameSize;
    string brakeType;
public:
    Twoweels() {};
    Twoweels(string mod, string col, int ye, int whe, double pri, double sp,
        bool bask, double fram, string brak) : Vehicle(mod, col, ye, whe, pri, sp)
    {
        hasBasket = bask;
        frameSize = fram;
        brakeType = brak;
    }

    void Print() override
    {
        Vehicle::Print();
        cout << "Basket " << hasBasket << endl;
        cout << "Size " << frameSize << endl;
        cout << "Brake " << brakeType << endl;
    }

    void Init(string mod, string col, int ye, int whe, double pri, double sp,
        bool bask, double fram, string brak)
    {
        Vehicle::Init(mod, col, ye, whe, pri, sp);
        hasBasket = bask;
        frameSize = fram;
        brakeType = brak;
    }

    void MaxSpeed() const override
    {
        cout << "Max speed " << max_speed << " km/h" << endl;
    }

    void FuelConsumption() const override
    {
        cout << "Fuel consumption 0 l/100 km" << endl;
    }

    void WheelsCount() const override
    {
        cout << "Wheels " << wheels << endl;
    }

    void PassengersCount() const override
    {
        cout << "Passengers of two-wheeler: 1" << endl;
    }
};

