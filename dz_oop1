class BankAccount{
private:
    string account_number;
    string owner;
    double balance;

public:
    string GetAccountNumber()
    {
        return account_number;
    }
    void SetAccountNumber(string acc_num)
    {
        if (acc_num != "")
        {
            account_number = acc_num;
        }
    }
    string GetOwner()
    {
        return owner;
    }
    void SetOwner(string own)
    {
        if (own != "")
        {
            owner = own;
        }
    }

    double GetBalance()
    {
        return balance;
    }
    void SetBalance(double bal)
    {
        if (bal >= 0)
        {
            balance = bal;
        }
        else
        {
            cout << "Баланс не может быть - \n";
        }
    }

    void Init(string acc_num, string own, double initial_balance)
    {
        account_number = acc_num;
        owner = own;
        
        if (initial_balance >= 0)
        {
            balance = initial_balance;
        }
        else
        {
            balance = 0;
            cout << "Стартовый баланс не может быть - \n";
        }
    }

    void Input()
    {
        cout << "Введите номер счета: ";
        cin >> account_number;

        cout << "Введите владельца счета: ";
        cin >> owner;

        cout << "Введите начальный баланс: ";
        cin >> balance;

        while (balance < 0)
        {
            cout << "Баланс не может быть - ";
            cin >> balance;
        }
    }

    void Deposit(double amount)
    {
        if (amount > 0)
        {
            balance += amount;
            cout << "Счет пополнен на " << amount << endl;
        }
        else
        {
            cout << "Сумма пополнения должна быть больше 0 \n";
        }
    }

    void Withdraw(double amount)
    {
        if (amount <= 0)
        {
            cout << "Сумма для снятия должна быть больше 0\n";
        }
        else if (amount > balance)
        {
            cout << "Ошибка: недостаточно средств на счете! Текущий баланс: " << balance << endl;
        }
        else
        {
            balance -= amount;
            cout << "Снято " << amount << " баланс: " << balance << endl;
        }
    }

    void PrintBalance()
    {
        cout << "Текущий баланс: " << balance << endl;
    }

    void PrintInfo()
    {
        cout << "Номер счета: " << account_number << endl;
        cout << "Владелец: " << owner << endl;
        cout << "Баланс: " << balance << endl;
    }
};

int main()
{
    BankAccount account1;
    account1.Init("12345", "Я", 1000);
    account1.PrintInfo();

    account1.Deposit(500);
    account1.PrintBalance();

    account1.Withdraw(3000); 
    account1.Withdraw(400);
    account1.PrintBalance();

    account1.Input();
    account1.PrintInfo();

    return 0;
}
