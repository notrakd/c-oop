class Student {
private:
	string name;
	string group;
	string speciality;
public:
	Student()//конструктор по умолчанию обнуление полей
	{
		cout << "constructor by default\n";
		name = "";
		speciality = " ";
		group = " ";
	}
	Student(string na, string spe, string gro)//конструктор с полями
	{
		name = na;
		speciality = spe;
		group = gro;
		cout << "constructor by 2 parametrs \n";
	}
	void Init(string na, string spe, string gro)
	{
		name = na;
		speciality = spe;
		group = gro;
	}
	void print()
	{
		cout << "Your group name - " << name;
		cout << "Your speciality name - " << speciality;
		cout << "Your group number - " << group;
	}

	string Getna()
	{
		return name;
	}
	void Set_na(string na)
	{
		name = na;
		cout << endl;
	}

	string Getspe()
	{
		return speciality;
	}
	void Setspe(string spe)
	{
		speciality = spe;
		cout << endl;
	}

	string Getgro()
	{
		return group;
	}
	void Setgro(string gro)
	{
		group = gro;
		cout << endl;
	}

	void changeGroup(string newGroup)
	{
		cout << "Write new Group";
		cin >> newGroup;
		group = newGroup;
	}
};

int main()
{
	Student obj1;// вызов конструктора поумолчанию
	obj1.Init("YA", "Programirovanie", "12");
	obj1.print();
	string new_group;
	obj1.changeGroup(new_group);
	obj1.print();

	Student obj2("TI", "dizigne", "123");
	obj2.print();

	
}


class User {
private:
	string login;
	string email;
	string password;

public:
	User()
	{
		cout << "constructor by default\n";
		login = "";
		email = "";
		password = "";
	}

	User(string log, string mail, string pass)
	{
		login = log;
		email = mail;
		password = pass;
		cout << "constructor by parametrs\n";
	}

	string Getlogin()
	{
		return login;
	}

	void Setlogin(string log)
	{
		login = log;
		cout << endl;
	}

	string Getemail()
	{
		return email;
	}

	void Setemail(string mail)
	{
		email = mail;
		cout << endl;
	}

	void Setpassword(string pass)
	{
		password = pass;
		cout << endl;
	}

	void showProfile()
	{
		cout << "Your login - " << login << endl;
		cout << "Your email - " << email << endl;
	}

	void changePassword(string oldPass, string newPass)
	{
		cout << "Write old password: ";
		cin >> oldPass;

		if (oldPass == password)
		{
			cout << "Write new password: ";
			cin >> newPass;
			password = newPass;
			cout << "Password changed!" << endl;
		}
		else
		{
			cout << "Wrong password!" << endl;
		}
	}
};

int main()
{
	User obj1;

	obj1.Setlogin("Dima");
	obj1.Setemail("dima@gmail.com");
	obj1.Setpassword("12345");

	obj1.showProfile();

	string oldPass;
	string newPass;

	obj1.changePassword(oldPass, newPass);

	obj1.showProfile();

	User obj2("Alex", "alex@gmail.com", "qwerty");

	obj2.showProfile();

	obj2.changePassword(oldPass, newPass);
}


