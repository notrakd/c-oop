class Student {
private:
	string name;
	string group;
	string speciality;
public:
	Student()//конструктор по умолчанию обнуление полей
	{
		cout << "constructor by default\n";
		name = "";
		speciality = " ";
		group = " ";
	}
	Student(string na, string spe, string gro)//конструктор с полями
	{
		name = na;
		speciality = spe;
		group = gro;
		cout << "constructor by 2 parametrs \n";
	}
	void Init(string na, string spe, string gro)
	{
		name = na;
		speciality = spe;
		group = gro;
	}
	void print()
	{
		cout << "Your group name - " << name;
		cout << "Your speciality name - " << speciality;
		cout << "Your group number - " << group;
	}

	string Getna()
	{
		return name;
	}
	void Set_na(string na)
	{
		name = na;
		cout << endl;
	}

	string Getspe()
	{
		return speciality;
	}
	void Setspe(string spe)
	{
		speciality = spe;
		cout << endl;
	}

	string Getgro()
	{
		return group;
	}
	void Setgro(string gro)
	{
		group = gro;
		cout << endl;
	}

	void changeGroup(string newGroup)
	{
		cout << "Write new Group";
		cin >> newGroup;
		group = newGroup;
	}
};

int main()
{
	Student obj1;// вызов конструктора поумолчанию
	obj1.Init("YA", "Programirovanie", "12");
	obj1.print();
	string new_group;
	obj1.changeGroup(new_group);
	obj1.print();

	Student obj2("TI", "dizigne", "123");
