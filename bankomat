#include <iostream>
#include <string>
#include "Bankomat.h"

using namespace std;

Bankomat::Bankomat()
{
    cout << "Constructor\n";
    id = 0;
    sum = 0;
    max = 0;
    min = 0;
}

Bankomat::Bankomat(int sum, int max, int min)
{
    id = 0;
    sum = sum;
    max = max;
    min = min;
}

void Bankomat::Init(int i, int su, int ma, int mi)
{
    id = i;
    sum = su;
    max = ma;
    min = mi;
}

void Bankomat::Print()
{
    cout << "Bankomat Id " << id << endl;
    cout << "Bancomat Sum " << sum << endl;
    cout << "Max snat " << max << endl;
    cout << "Min snat " << min << endl;
}

int Bankomat::GetId()
{
    return id;
}

int Bankomat::GetSum()
{
    return sum;
}

int Bankomat::GetMax()
{
    return max;
}

int Bankomat::GetMin()
{
    return min;
}

void Bankomat::SetId(int i)
{
    if (i > 0)
    {
        id = i;
    }
    else
    {
        id = 0;
    }
}

void Bankomat::SetSum(int su)
{
    if (su >= 0)
    {
        sum = su;
    }
    else
    {
        sum = 0;
    }
}

void Bankomat::SetMin(int mi)
{
    if (mi >= 0)
    {
        min = mi;
    }
    else
    {
        min = 0;
    }
}

void Bankomat::SetMax(int ma)
{
    if (ma >= min)
    {
        max = ma;
    }
    else
    {
        max = min;
    }
}

int Bankomat::Bank_snat(int amount)
{
    if (amount <= 0)
    {
        cout << "Error\n";
        return 0;
    }

    if (amount < min)
    {
        cout << "Error " << min << endl;
        return 0;
    }

    if (amount > max)
    {
        cout << "Error " << max << endl;
        return 0;
    }

    if (amount > sum)
    {
        cout << "Eror"  << sum << endl;
        return 0;
    }

    sum -= amount;
    cout << "Good " << amount << "Money on bankomat " << sum << endl;

    return amount;
}
