#include "new_project.h"

int main()
{
    Pair<string, double> obj1("Алексей", 20);
    obj1.show();
    

    Pair<string, double> obj2("Ноутбук", 450);
    obj2.show();

    obj2.copyFrom(obj1);
    obj2.show();
    Pair<int, double> obj3(101, 5);
    obj3.clear();
    obj3.show();
    return 0;

}











#pragma once
#include <iostream>
using namespace std;

template<class T1, class T2>
class Pair
{
   T1 a;
   T2 b;
public:
    Pair();
    Pair(T1 a, T2 b);
    void show() const;
    T1 getFirst() const;
    T2 getSecond() const;
    void copyFrom(const Pair<T1, T2>& other);
    void clear();
};

    template<class T1, class T2>
    Pair<T1, T2>::Pair() : a(T1{}), b(T2{}) {}

    template<class T1, class T2>
    Pair<T1, T2>::Pair(T1 a, T2 b) : a(a), b(b) {}

    template<class T1, class T2>
    void Pair<T1, T2>::show() const
    {
        cout << a << b << endl;
    }

    template<class T1, class T2>
    T1 Pair<T1, T2>::getFirst() const
    {
        return a;
    }
    
    template<class T1, class T2>
    T2 Pair<T1, T2>::getSecond()const
    {
        return b;
    }

    template<class T1, class T2>
    void Pair<T1, T2>::copyFrom(const Pair<T1, T2>& other)
    {
        a = other.a;
        b = other.b;
    }

    template<class T1, class T2>
    void Pair<T1, T2>::clear()
    {
        a = T1{};
        b = T2{};
    }

